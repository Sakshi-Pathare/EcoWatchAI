# SQLite is used by default and creates backend/ecowatch.db.
# For PostgreSQL, use: postgresql+psycopg://user:password@localhost:5432/ecowatch
# DATABASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required to bootstrap the first platform administrator on API startup.
# Replace both values with private credentials; password must be at least 12 characters.
# ECOWATCH_SUPERADMIN_EMAIL=admin@example.com
# ECOWATCH_SUPERADMIN_PASSWORD=

# Optional. Point this at a YOLO model trained for litter/waste classes.
# Install the optional AI requirements before setting this value.
# YOLO_MODEL_PATH=C:\models\ecowatch-litter.pt
